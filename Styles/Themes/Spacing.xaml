<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing Values -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingS">8</sys:Double>
    <sys:Double x:Key="SpacingM">16</sys:Double>
    <sys:Double x:Key="SpacingL">24</sys:Double>
    <sys:Double x:Key="SpacingXL">32</sys:Double>
    <sys:Double x:Key="SpacingXXL">48</sys:Double>
    
    <!-- Margin Thickness -->
    <Thickness x:Key="MarginXS">4</Thickness>
    <Thickness x:Key="MarginS">8</Thickness>
    <Thickness x:Key="MarginM">16</Thickness>
    <Thickness x:Key="MarginL">24</Thickness>
    <Thickness x:Key="MarginXL">32</Thickness>
    
    <!-- Padding Thickness -->
    <Thickness x:Key="PaddingXS">4</Thickness>
    <Thickness x:Key="PaddingS">8</Thickness>
    <Thickness x:Key="PaddingM">16</Thickness>
    <Thickness x:Key="PaddingL">24</Thickness>
    <Thickness x:Key="PaddingXL">32</Thickness>
    
    <!-- Border Radius -->
    <CornerRadius x:Key="RadiusXS">2</CornerRadius>
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusS">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXS">2</CornerRadius>
    
    <!-- Elevation (Shadow Effects) -->
    <DropShadowEffect x:Key="Elevation1" BlurRadius="4" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
    <DropShadowEffect x:Key="Elevation2" BlurRadius="8" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
    <DropShadowEffect x:Key="Elevation3" BlurRadius="12" ShadowDepth="4" Opacity="0.20" Color="#000000"/>
    <DropShadowEffect x:Key="Elevation4" BlurRadius="16" ShadowDepth="6" Opacity="0.24" Color="#000000"/>
    
    <!-- Component Specific Spacing -->
    <Thickness x:Key="ButtonPadding">12,8</Thickness>
    <Thickness x:Key="ButtonPaddingLarge">16,12</Thickness>
    <Thickness x:Key="TextFieldPadding">12,8</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">24</Thickness>
    
    <!-- Grid Spacing -->
    <sys:Double x:Key="GridSpacingS">8</sys:Double>
    <sys:Double x:Key="GridSpacingM">16</sys:Double>
    <sys:Double x:Key="GridSpacingL">24</sys:Double>
    
</ResourceDictionary> 