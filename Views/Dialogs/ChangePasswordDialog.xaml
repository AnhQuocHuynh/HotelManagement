<Window x:Class="HotelManager.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:HotelManager.Converters"
        xmlns:helpers="clr-namespace:HotelManager.Helpers"
        Title="Change Password" Height="634" Width="521"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:PasswordVisibilityToIconConverter x:Key="PasswordVisibilityToIconConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="Key" 
                                   Width="48" Height="48" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
            <TextBlock Text="Change Password" 
                     Style="{StaticResource HeadlineMedium}"
                     HorizontalAlignment="Center"
                     Margin="0,16,0,8"/>
            <TextBlock Text="Enter your current password and choose a new one" 
                     Style="{StaticResource BodyMedium}"
                     Foreground="{StaticResource OnSurfaceVariantBrush}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <!-- Current Password -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Current Password *" Style="{StaticResource LabelLarge}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <!-- TextBox for visible password -->
                    <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"                   
                             materialDesign:HintAssist.Hint="Enter your current password"
                             materialDesign:HintAssist.IsFloating="False"
                             FontSize="16" Padding="16,12,12,12" Grid.Column="0" Background="White">    
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- PasswordBox for hidden password -->
                    <PasswordBox x:Name="CurrentPasswordBox"
                         helpers:PasswordBoxAssistant.BoundPassword="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                        
                         materialDesign:HintAssist.Hint="Enter your current password"
                         materialDesign:HintAssist.IsFloating="False"
                         FontSize="16" Padding="16,12,12,12" Grid.Column="0" Background="White">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <ToggleButton IsChecked="{Binding IsCurrentPasswordVisible, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignActionToggleButton}"
                          Width="24" Height="24"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          Grid.Column="1">
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="Eye" Width="20" Height="20"/>
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="EyeOff" Width="20" Height="20"/>
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <!-- New Password -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="New Password *" Style="{StaticResource LabelLarge}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- TextBox for visible password -->
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"                   
                 materialDesign:HintAssist.Hint="Enter new password"
                 materialDesign:HintAssist.IsFloating="False"
                 FontSize="16" Padding="16,12,12,12" Grid.Column="0" Background="White">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- PasswordBox for hidden password -->
                    <PasswordBox x:Name="NewPasswordBox"
             helpers:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                        
             materialDesign:HintAssist.Hint="Enter new password"
             materialDesign:HintAssist.IsFloating="False"
             FontSize="16" Padding="16,12,12,12" Grid.Column="0" Background="White">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <!-- Eye toggle -->
                    <ToggleButton IsChecked="{Binding IsNewPasswordVisible, Mode=TwoWay}"
                      Style="{StaticResource MaterialDesignActionToggleButton}"
                      Width="24" Height="24"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Grid.Column="1">
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="Eye" Width="20" Height="20"/>
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="EyeOff" Width="20" Height="20"/>
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </Grid>

                <TextBlock Text="Password must be at least 8 characters long and contain at least one number"
               Style="{StaticResource BodySmall}"
               Foreground="{StaticResource OnSurfaceVariantBrush}"
               Margin="0,4,0,0"
               TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Confirm New Password -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Confirm New Password *" Style="{StaticResource LabelLarge}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- TextBox for visible password -->
                    <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"                   
                 materialDesign:HintAssist.Hint="Confirm new password"
                 materialDesign:HintAssist.IsFloating="False"
                 FontSize="16" Padding="16,12,12,12" Grid.Column="0" Background="White">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfirmPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- PasswordBox for hidden password -->
                    <PasswordBox x:Name="ConfirmPasswordBox"
             helpers:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                        
             materialDesign:HintAssist.Hint="Confirm new password"
             materialDesign:HintAssist.IsFloating="False"
             FontSize="16" Padding="16,12,12,12" Grid.Column="0" Background="White">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfirmPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <!-- Eye toggle -->
                    <ToggleButton IsChecked="{Binding IsConfirmPasswordVisible, Mode=TwoWay}"
                      Style="{StaticResource MaterialDesignActionToggleButton}"
                      Width="24" Height="24"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Grid.Column="1">
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="Eye" Width="20" Height="20"/>
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="EyeOff" Width="20" Height="20"/>
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <!-- Password Strength Indicator -->
            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsPasswordValid, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Password Strength:" 
                         Style="{StaticResource BodyMedium}"
                         FontWeight="Medium"
                         Margin="0,0,0,4"/>
                <ProgressBar Value="{Binding PasswordStrength}" 
                           Maximum="100"
                           Height="4"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding PasswordStrengthText}" 
                         Style="{StaticResource BodySmall}"
                         Foreground="{Binding PasswordStrengthColor}"/>
            </StackPanel>

            <!-- Error Message: chỉ hiển thị lỗi đầu tiên -->
            <TextBlock Text="{Binding FirstErrorMessage}" 
                     Style="{StaticResource BodyMedium}"
                     Foreground="{StaticResource ErrorBrush}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"
                     Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}"
                  Style="{StaticResource OutlinedButton}"
                  Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Cancel"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ChangePasswordCommand}"
                  Style="{StaticResource ContainedButton}"
                  IsEnabled="{Binding IsPasswordValid}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Key" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Change Password"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window> 