<Window x:Class="HotelManager.Views.RoomInfoEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManager.Views"
        mc:Ignorable="d"
        Title="RoomInfoEditView" Height="450" Width="800">
    <Border Background="White"
            BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="10"
            CornerRadius="8">

        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <TextBlock Text="Edit Room Information"
                       FontSize="20"
                       Foreground="{StaticResource PrimaryBrush}"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Room Number:" Foreground="{StaticResource SecondaryBrush}" />
            <TextBlock Text="{Binding EditableRoom.RoomNumber}"
           FontWeight="Bold"
           Foreground="Black"
           Margin="0,5,0,10"/>

            <TextBlock Text="Room Type:" Foreground="{StaticResource SecondaryBrush}" />
            <ComboBox ItemsSource="{Binding RoomTypes}"
                      SelectedItem="{Binding EditableRoom.RoomType}"
                      Margin="0,5,0,10"/>

            <TextBlock Text="Status:" Foreground="{StaticResource SecondaryBrush}" />
            <ComboBox ItemsSource="{Binding RoomStatuses}"
                      SelectedItem="{Binding EditableRoom.RoomStatus}"
                      Margin="0,5,0,10"/>

            <TextBlock Text="Price per Night:" Foreground="{StaticResource SecondaryBrush}" />
            <TextBox Text="{Binding EditableRoom.PricePerNight, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="10,5"
                        Margin="0,0,10,0"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Padding="10,5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
