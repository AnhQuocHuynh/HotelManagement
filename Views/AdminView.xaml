<Window x:Class="HotelManager.Views.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManager.Views"
        xmlns:vm="clr-namespace:HotelManager.ViewModels"
        mc:Ignorable="d"
        Title="AdminView" Height="450" Width="800">
    <Window.DataContext>
        <vm:AdminViewModel />
    </Window.DataContext>
    <Grid Background="{StaticResource AccentBrush}">
        <!-- Grid for displaying accounts -->
        <DataGrid ItemsSource="{Binding Employees}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"               
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedEmployee}"
                  Margin="0,70,0,0"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  CanUserResizeRows="False"
                  CanUserResizeColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" />
                <DataGridTextColumn Header="Hire Date" Binding="{Binding HireDate, StringFormat=d}" />
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Username" Binding="{Binding UserAccount.Username}" Width="*"/>

                <DataGridTemplateColumn Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Style="{StaticResource DefaultButtonStyle}"/>
                                <Button Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Margin="5,0,0,0" Style="{StaticResource DefaultButtonStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Labels and TextBoxes -->
        <Grid VerticalAlignment="Top" Margin="0,0,150,0"  >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Labels -->
                <RowDefinition Height="Auto"/>
                <!-- Inputs -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Labels -->
            <TextBlock Text="Full Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Background="Azure" Padding="5"/>
            <TextBlock Text="Email:" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Background="Azure" Padding="5"/>
            <TextBlock Text="Phone Number:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Background="Azure" Padding="5"/>
            <TextBlock Text="Position:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Background="Azure" Padding="5"/>
            <TextBlock Text="Hire Date:" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Background="Azure" Padding="5"/>

            <!-- Input Controls -->
            <TextBox x:Name="FullnameTextBox" Grid.Row="1" Grid.Column="0" Height="30" Margin="0,5,5,5" Style="{StaticResource DefaultTextBoxStyle}" Text="{Binding EmployeeFullName, Mode=TwoWay}"/>
            <TextBox x:Name="EmailTextBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5,5,5" Style="{StaticResource DefaultTextBoxStyle}" Text="{Binding EmployeeEmail, Mode=TwoWay}"/>
            <TextBox x:Name="PhoneNumberTextBox" Grid.Row="1" Grid.Column="2" Height="30" Margin="0,5,5,5" Style="{StaticResource DefaultTextBoxStyle}" Text="{Binding EmployeePhoneNumber, Mode=TwoWay}"/>
            <ComboBox x:Name="PositionBox" Grid.Row="1" Grid.Column="3" Height="30" Margin="0,5,5,5" ItemsSource="{Binding EmployeePositions}" SelectedItem="{Binding SelectedPosition, Mode=TwoWay}" BorderBrush="{DynamicResource PrimaryBrush}" />
            <DatePicker x:Name="HireDateTextBox" Grid.Row="1" Grid.Column="4" Height="30" Margin="0,5,0,5" HorizontalAlignment="Left" Width="125" SelectedDate="{Binding EmployeeHireDate, Mode=TwoWay}"/>
        </Grid>

        <!-- Add Employee Button -->
        <Button Content="Add New Employee"
            Command="{Binding AddNewEmployeeCommand}"
            Style="{StaticResource DefaultButtonStyle}"
            Width="150"
            Height="30"
            FontWeight="Bold"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,33,0,0"/>
    </Grid>
</Window>
