<UserControl x:Class="HotelManager.Views.StaffViews.CleanerView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:HotelManager.Converters"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900" 
             Background="#F4F4F4" FontSize="16">
    <UserControl.Resources>
        <!-- Style cho nút hiện đại -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Header cho DataGrid -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- CheckBox trong DataGrid: khi phòng đã dọn (IsCleaned=True) thì vô hiệu hóa -->
        <Style x:Key="CheckBoxCellStyle" TargetType="CheckBox">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCleaned}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <local:SplitImagePathConverter x:Key="SplitImagePathConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header with title and logout button -->
            <RowDefinition Height="Auto" />
            <!-- Content area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with title and logout button -->
        <Border Background="#007ACC" Height="50" Grid.Row="0">
            <Grid>
                <TextBlock Text="Cleaner Dashboard" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="20,0,0,0"/>
                <Button Content="Logout" 
                        Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Width="80" 
                        Height="30" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,20,0"
                        Background="DarkRed"
                        Foreground="White"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <!-- Notification Banner -->
                <RowDefinition Height="Auto" />
                <!-- Danh sách phòng cần dọn -->
                <RowDefinition Height="*" />
                <!-- Phần báo cáo hư hỏng -->
                <RowDefinition Height="Auto" />
                <!-- Lịch sử báo cáo hư hỏng/phòng đã dọn -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Notification Banner -->
            <Border x:Name="NotificationBanner" Background="#e0f7fa" Padding="10" CornerRadius="4" Grid.Row="0">
                <DockPanel>
                    <TextBlock Text="You are Cleaner" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="X" Width="23" Height="20" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Foreground="Black"  />
                </DockPanel>
            </Border>

            <!-- DataGrid danh sách phòng cần dọn -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding RoomsToClean}" AutoGenerateColumns="False" Margin="0,10,0,10" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Số phòng" Binding="{Binding RoomNumber}" Width="*" />
                    <DataGridTextColumn Header="Loại phòng" Binding="{Binding RoomType}" Width="*" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding IsAvailable}" Width="*" />
                    <DataGridTemplateColumn Header="Hành động" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Dọn xong" Command="{Binding DataContext.MarkAsCleanedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,10,0" />
                                    <Button Content="Báo lỗi" Command="{Binding DataContext.ReportIssueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Phần báo cáo hư hỏng (cho phép nhập số phòng, mô tả, kèm nhiều ảnh) -->
            <Expander Grid.Row="2" Header="Báo cáo hư hỏng" IsExpanded="{Binding IsReportExpanded}" FontSize="16" Margin="0,10,0,0">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                        <TextBlock Text="Số phòng:" />
                        <TextBox Text="{Binding DamageReport.RoomNumber}" Margin="0,5,0,10" />
                        <TextBlock Text="Chi tiết vật dụng hư hỏng:" />
                        <TextBox Text="{Binding DamageReport.Description}" Margin="0,5,0,10" AcceptsReturn="True" Height="60" />
                        <TextBlock Text="Ảnh (Tùy chọn, có thể chọn nhiều):" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                            <Button Content="Chọn ảnh" Command="{Binding SelectImageCommand}" Style="{StaticResource ModernButtonStyle}" />
                        </StackPanel>
                        <!-- Hiển thị danh sách ảnh đã chọn -->
                        <ItemsControl ItemsSource="{Binding ImagePaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding}" Width="200" TextTrimming="CharacterEllipsis" />
                                        <Button Content="X" Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="25" Height="25" Margin="5,0,0,0"/>
                                        <Button Content="Xem" Width="40" Height="25" Margin="5,0,0,0" Click="OnViewImageClick" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Content="Gửi báo cáo hư hỏng" Command="{Binding SendDamageReportCommand}" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" />
                </StackPanel>
            </Expander>

            <!-- Lịch sử báo cáo hư hỏng/phòng đã dọn -->
            <GroupBox Header="Lịch sử báo cáo &amp; phòng đã dọn" Grid.Row="3" Margin="0,10,0,0">
                <DataGrid ItemsSource="{Binding DamageReportHistory}" AutoGenerateColumns="False" Height="200" Margin="0,5,0,0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số phòng" Binding="{Binding RoomNumber}" Width="*" />
                        <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Ngày báo cáo" Binding="{Binding ReportedDate, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                        <DataGridTemplateColumn Header="Ảnh" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding ImagePath, Converter={StaticResource SplitImagePathConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="Xem ảnh" Width="70" Margin="2" Click="OnViewHistoryImageClick" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
