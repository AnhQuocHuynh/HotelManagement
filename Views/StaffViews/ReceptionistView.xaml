<UserControl x:Class="HotelManager.Views.StaffViews.ReceptionistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HotelManager.Views.StaffViews"
             xmlns:enums="clr-namespace:HotelManager.Models.Enums;assembly=HotelManager.Core"
             xmlns:vm="clr-namespace:HotelManager.ViewModels.StaffViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceptionistViewModel, IsDesignTimeCreatable=True}" d:DesignWidth="1400" Height="1384">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>



    <UserControl.Resources>
        <!-- ObjectDataProvider cho BookingStatus -->
        <ObjectDataProvider x:Key="BookingStatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BookingStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- ObjectDataProvider cho CustomerType -->
        <ObjectDataProvider x:Key="CustomerTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:CustomerType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- ObjectDataProvider cho RoomType -->
        <ObjectDataProvider x:Key="RoomTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:RoomType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Quick Stats Card Style -->
        <Style x:Key="QuickStatsCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Effect" Value="{StaticResource Elevation1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource Elevation2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceGradient}" Margin="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32">

                <!-- Header Section -->
                <materialDesign:Card Margin="0,0,0,24">
                    <Border Background="{StaticResource PrimaryGradient}" 
                            CornerRadius="{StaticResource RadiusM}" 
                            Padding="32"
                            Effect="{StaticResource Elevation2}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Welcome Section -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="White" 
                                        CornerRadius="30" 
                                        Width="60" 
                                        Height="60" 
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="Bell" 
                                                             Foreground="{StaticResource PrimaryBrush}" 
                                                             Width="32" 
                                                             Height="32"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hello! Receptionist" 
                                               Style="{StaticResource BodyLarge}"
                                               Foreground="White" 
                                               Opacity="0.9"/>
                                    <TextBlock Text="Booking Management" 
                                               Style="{StaticResource HeadlineMedium}"
                                               Foreground="White" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick Stats -->
                            <StackPanel Grid.Column="1" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                <Button Command="{Binding ShowBookingsCommand}" Style="{StaticResource OutlinedButton}" Margin="8,0" Background="White">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarCheck" Foreground="{StaticResource PrimaryBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalBookings, StringFormat='{}{0} Bookings'}" Style="{StaticResource LabelLarge}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!--
                                <Button Command="{Binding NavigateToRoomViewCommand}" Style="{StaticResource OutlinedButton}" Margin="8,0" Background="White">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BedKingOutline" Foreground="{StaticResource SuccessBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="Room Status" Style="{StaticResource LabelLarge}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button> -->
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Center">
                               

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="btnProfile" Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Profile" Command="{Binding NavigateProfileCommand}" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="Account" Foreground="White"/>
                                    </Button>
                                    <Button x:Name="btnLogout" Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Logout" Command="{Binding LogoutCommand}" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Logout" Foreground="White"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <!-- Booking Form Section -->
                <materialDesign:Card Padding="24" 
                                     Margin="0,0,0,24"
                                     Effect="{StaticResource Elevation2}">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarPlus" 
                                                         Foreground="{StaticResource PrimaryBrush}" 
                                                         Width="24" 
                                                         Height="24" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="New Booking" 
                                           Style="{StaticResource SectionHeader}"
                                           Margin="12,0,0,0" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Style="{StaticResource TextButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RefreshCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" 
                                                                 Width="16" 
                                                                 Height="16" 
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" 
                                                   Margin="4,0,0,0" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <!-- Customer Information -->
                        <TextBlock Text="Customer Information" 
                                   Style="{StaticResource HeadlineSmall}"
                                   Margin="0,0,0,16"/>

                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Full Name *" 
                                           Style="{StaticResource LabelLarge}"
                                           Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource OutlinedTextField}"
                                         materialDesign:HintAssist.Hint="Enter customer full name"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Text="{Binding CustomerFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="8,0">
                                <TextBlock Text="ID Card *" 
                                           Style="{StaticResource LabelLarge}"
                                           Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource OutlinedTextField}"
                                         materialDesign:HintAssist.Hint="Enter ID number"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Text="{Binding CustomerCCCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Phone Number *" 
                                           Style="{StaticResource LabelLarge}"
                                           Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource OutlinedTextField}"
                                         materialDesign:HintAssist.Hint="Enter phone number"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Text="{Binding CustomerPhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Booking Information -->
                        <TextBlock Text="Booking Information" 
                                   Style="{StaticResource HeadlineSmall}"
                                   Margin="0,16,0,16"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1 -->
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,20">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Customer Type *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Select customer type"
                                              materialDesign:HintAssist.IsFloating="False"
                      SelectedItem="{Binding SelectedCustomerType, Mode=TwoWay}"
                                              ItemsSource="{Binding Source={StaticResource CustomerTypeEnum}}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0">
                                    <TextBlock Text="Room Type *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Select room type"
                                              materialDesign:HintAssist.IsFloating="False"
                      SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}"
                                              ItemsSource="{Binding Source={StaticResource RoomTypeEnum}}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Room Number *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Select room number"
                                              materialDesign:HintAssist.IsFloating="False"
                                              ItemsSource="{Binding AvailableRooms}" 
                                              SelectedItem="{Binding SelectedRoomNumber, Mode=TwoWay}"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Row 2 -->
                            <UniformGrid Grid.Row="1" Columns="3">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Check-in Date *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <DatePicker Style="{StaticResource MaterialDesignDatePicker}"
                                                materialDesign:HintAssist.Hint="Pick check-in date"
                                                materialDesign:HintAssist.IsFloating="False"
                                                SelectedDate="{Binding CheckInDate, Mode=TwoWay}" Height="52"/>
                                </StackPanel>

                                <StackPanel Margin="8,0">
                                    <TextBlock Text="Check-out Date *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <DatePicker Style="{StaticResource MaterialDesignDatePicker}"
                                                materialDesign:HintAssist.Hint="Pick check-out date"
                                                materialDesign:HintAssist.IsFloating="False"
                                                SelectedDate="{Binding CheckOutDate, Mode=TwoWay}" Height="51"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Status *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Select status"
                                              materialDesign:HintAssist.IsFloating="False"
                                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                              ItemsSource="{Binding Source={StaticResource BookingStatusEnum}}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                                    Margin="0,24,0,0">
                            <Button Content="Save"
                                    Style="{StaticResource ContainedButton}"
                                    Command="{Binding AddNewBookingCommand}"
                                    Margin="0,0,12,0"/>
                            <Button Content="Cancel"
                                    Style="{StaticResource OutlinedButton}"
                                    Margin="0,0,12,0"
                                    Command="{Binding ClearFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Bookings List Section -->
                <materialDesign:Card Padding="24"
                                     Effect="{StaticResource Elevation2}">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMultiple" 
                                                         Foreground="{StaticResource PrimaryBrush}" 
                                                         Width="24" 
                                                         Height="24" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Booking List" 
                                           Style="{StaticResource SectionHeader}"
                                           Margin="12,0,0,0" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Search Box -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Style="{StaticResource OutlinedTextField}"
                                         materialDesign:HintAssist.Hint="Search bookings..."
                                         materialDesign:HintAssist.IsFloating="False"
                                         Width="250"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding SearchCommand}"
                                        ToolTip="Search"
                                        Margin="8,0,0,0">
                                    <materialDesign:PackIcon Kind="Magnify" 
                                                             Width="20" 
                                                             Height="20"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Data Grid -->
                        <Border Background="{StaticResource BackgroundBrush}" 
                                CornerRadius="{StaticResource RadiusS}" 
                                BorderBrush="{StaticResource OnSurfaceVariantBrush}" 
                                BorderThickness="1">
                            <DataGrid ItemsSource="{Binding Bookings}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"               
                      SelectionMode="Single"
                                      Style="{StaticResource ModernDataGrid}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      CanUserResizeRows="False"
                                      CanUserSortColumns="True"
                                      MinHeight="400" SelectionChanged="DataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <!-- Status Indicator -->
                                    <DataGridTemplateColumn Header="" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="12" Height="12">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="CheckedIn">
                                                                    <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Customer Name" 
                                                        Binding="{Binding Customer.FullName}" 
                                                        Width="2*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="ID" 
                                                        Binding="{Binding Customer.CCCD}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Phone Number" 
                                                        Binding="{Binding Customer.PhoneNumber}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Customer Type" 
                                                        Binding="{Binding Customer.Type}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Room Type" 
                                                        Binding="{Binding RoomType}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Room Number" 
                                                        Binding="{Binding RoomNumber}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Check-in" 
                                                        Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Check-out" 
                                                        Binding="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Status" 
                                                        Binding="{Binding Status}" 
                                                        Width="*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <!-- Actions Column -->
                                    <DataGridTemplateColumn Header="Actions" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center">
                                                    <Button ToolTip="Edit" 
                                            Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource IconButton}"
                                                            Width="32" 
                                                            Height="32"
                                                            Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="Pencil" 
                                                                                 Width="16" 
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource PrimaryBrush}"/>
                                                    </Button>

                                                    <Button ToolTip="Checkout" 
                                            Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource IconButton}"
                                                            Width="32" 
                                                            Height="32"
                                                            Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="ExitToApp" 
                                                                                 Width="16" 
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource SuccessBrush}"/>
                                                    </Button>

                                                    <Button ToolTip="Delete" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource IconButton}"
                                                            Width="32" 
                                                            Height="32">
                                                        <materialDesign:PackIcon Kind="Delete" 
                                                                                 Width="16" 
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource ErrorBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>