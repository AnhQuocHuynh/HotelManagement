<UserControl x:Class="HotelManager.Views.StaffViews.ReceptionistRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HotelManager.ViewModels.StaffViewModels"
             xmlns:enums="clr-namespace:HotelManager.Models.Enums;assembly=HotelManager.Core"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <!-- Room Status Colors -->
        <SolidColorBrush x:Key="PendingBrush" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="AvailableBrush" Color="#E8F5E8"/>
        <SolidColorBrush x:Key="MaintainingBrush" Color="#FFEBEE"/>
        
        <!-- Room Card Style -->
        <Style x:Key="RoomCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AvailableBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OnSurfaceVariantBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource Elevation1}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource Elevation2}"/>
                </Trigger>
                <DataTrigger Binding="{Binding RoomStatus}" Value="Pending">
                    <Setter Property="Background" Value="{StaticResource PendingBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RoomStatus}" Value="Maintaining">
                    <Setter Property="Background" Value="{StaticResource MaintainingBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status Indicator Style -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RoomStatus}" Value="Pending">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RoomStatus}" Value="Maintaining">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceGradient}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                
                <!-- Header Section -->
                <materialDesign:Card Margin="0,0,0,24">
                    <Border Background="{StaticResource PrimaryGradient}" 
                            CornerRadius="{StaticResource RadiusM}" 
                            Padding="32"
                            Effect="{StaticResource Elevation2}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Welcome Section -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="White" 
                                        CornerRadius="30" 
                                        Width="60" 
                                        Height="60" 
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="BedKingOutline" 
                                                             Foreground="{StaticResource PrimaryBrush}" 
                                                             Width="32" 
                                                             Height="32"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Room Status Overview" 
                                               Style="{StaticResource BodyLarge}"
                                               Foreground="White" 
                                               Opacity="0.9"/>
                                    <TextBlock Text="Receptionist Room Management" 
                                               Style="{StaticResource HeadlineMedium}"
                                               Foreground="White" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick Stats -->
                            <StackPanel Grid.Column="1" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                <Border Background="White" 
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AvailableRoomsCount, StringFormat='{}{0} Available'}" 
                                                   Style="{StaticResource LabelLarge}" 
                                                   Foreground="{StaticResource SuccessBrush}" 
                                                   FontWeight="SemiBold" 
                                                   Margin="8,0,0,0" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" 
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PendingRoomsCount, StringFormat='{}{0} Pending'}" 
                                                   Style="{StaticResource LabelLarge}" 
                                                   Foreground="{StaticResource WarningBrush}" 
                                                   FontWeight="SemiBold" 
                                                   Margin="8,0,0,0" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" 
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MaintainingRoomsCount, StringFormat='{}{0} Maintaining'}" 
                                                   Style="{StaticResource LabelLarge}" 
                                                   Foreground="{StaticResource ErrorBrush}" 
                                                   FontWeight="SemiBold" 
                                                   Margin="8,0,0,0" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlinedButton}" Command="{Binding BackToReceptionistViewCommand}" Background="White" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{StaticResource PrimaryBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="Back" Style="{StaticResource LabelLarge}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnProfile" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Profile" Command="{Binding NavigateProfileCommand}" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Account" Foreground="White"/>
                                </Button>
                                <Button x:Name="btnLogout" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Logout" Command="{Binding LogoutCommand}" Margin="8,0,0,0">
                                    <materialDesign:PackIcon Kind="Logout" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource OutlinedButton}" Command="{Binding RefreshCommand}" Background="White" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Foreground="{StaticResource PrimaryBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" Style="{StaticResource LabelLarge}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <!-- Filters Section -->
                <materialDesign:Card Margin="0,0,0,24" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Filters" 
                                   Style="{StaticResource HeadlineSmall}"
                                   Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Room Type" 
                                           Style="{StaticResource LabelLarge}"
                                           Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="All Room Types"
                                          materialDesign:HintAssist.IsFloating="False"
                                          SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}">
                                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                                    <ComboBoxItem Content="Standard"/>
                                    <ComboBoxItem Content="Deluxe"/>
                                    <ComboBoxItem Content="Suite"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="Room Status" 
                                           Style="{StaticResource LabelLarge}"
                                           Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="All Status"
                                          materialDesign:HintAssist.IsFloating="False"
                                          SelectedItem="{Binding SelectedRoomStatus, Mode=TwoWay}">
                                    <ComboBoxItem Content="All Status" IsSelected="True"/>
                                    <ComboBoxItem Content="Available"/>
                                    <ComboBoxItem Content="Pending"/>
                                    <ComboBoxItem Content="UnderMaintenance"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Search" 
                                           Style="{StaticResource LabelLarge}"
                                           Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource OutlinedTextField}"
                                         materialDesign:HintAssist.Hint="Search room number..."
                                         materialDesign:HintAssist.IsFloating="False"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Room Grid Section -->
                <materialDesign:Card Padding="24">
                    <StackPanel>
                        <TextBlock Text="Room Status Overview" 
                                   Style="{StaticResource HeadlineSmall}"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Room Grid -->
                        <ItemsControl ItemsSource="{Binding Rooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RoomCardStyle}"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="RoomCard_MouseLeftButtonUp">
                                        <StackPanel>
                                            <!-- Room Header -->
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusIndicatorStyle}" 
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RoomStatus}" 
                                                               Style="{StaticResource BodySmall}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Room Number -->
                                            <TextBlock Text="{Binding RoomNumber}" 
                                                       Style="{StaticResource HeadlineSmall}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,4"/>
                                            
                                            <!-- Room Type -->
                                            <TextBlock Text="{Binding RoomType}" 
                                                       Style="{StaticResource BodyMedium}"
                                                       Opacity="0.7"
                                                       Margin="0,0,0,8"/>
                                            
                                            <!-- Price -->
                                            <TextBlock Text="{Binding PricePerNight, StringFormat='{}{0:#,##0} ₫'}" 
                                                       Style="{StaticResource BodyMedium}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
