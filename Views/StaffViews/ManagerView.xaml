<UserControl x:Class="HotelManager.Views.StaffViews.ManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManager.Views.StaffViews"
        xmlns:vm="clr-namespace:HotelManager.ViewModels.StaffViewModels"

        mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="White">
        <!-- Header with title and logout button -->
        <Border Background="{StaticResource PrimaryBrush}" Height="50" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Manager Dashboard" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="20,0,0,0"/>
                <Button Content="Logout" 
                        Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Width="80" 
                        Height="30" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,20,0"
                        Background="DarkRed"
                        Foreground="White"/>
            </Grid>
        </Border>
        
        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="CurrentContent"
                            Grid.Row="1"
                            Content="{Binding CurrentContent}"/>


            <ComboBox x:Name="comboBox_Options"
                      Height="30"
                      Width="150"
                      Grid.Row="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,10,10,0"
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedOption}"/>
        </Grid>
    </Grid>
</UserControl>
