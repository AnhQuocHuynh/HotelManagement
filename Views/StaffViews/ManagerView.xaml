<UserControl x:Class="HotelManager.Views.StaffViews.ManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManager.Views.StaffViews"
        xmlns:vm="clr-namespace:HotelManager.ViewModels.StaffViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DesignHeight="800" d:DesignWidth="1200">

    <materialDesign:Card Effect="{StaticResource Elevation3}">
        <Grid Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Height="80">
                <Grid Margin="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Manager Title and Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Manager Dashboard" 
                                   Style="{StaticResource HeadlineLarge}" 
                                   Foreground="White"/>
                        <TextBlock Text="Manage hotel operations and reports" 
                                   Style="{StaticResource BodyMedium}" 
                                   Foreground="{StaticResource OnPrimary200Brush}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- View Options ComboBox -->
                    <materialDesign:Card Grid.Column="1" 
                                        Margin="0,0,24,0" 
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Primary200Brush}">
            <ComboBox x:Name="comboBox_Options"
                                  MinWidth="200"
                      ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding SelectedOption}"
                                  materialDesign:HintAssist.Hint="Select View"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  Background="Transparent"
                                  Foreground="White">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                    </materialDesign:Card>

                    <!-- Logout Button -->
                    <Button Grid.Column="2" 
                            Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Style="{StaticResource TextButton}"
                            Background="{StaticResource ErrorBrush}"
                            Foreground="White"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" 
                                                   Width="20" Height="20" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Logout" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stats Cards -->
                <UniformGrid Grid.Row="0" Rows="1" Columns="3" 
                             Margin="0,24,0,32">
                    <!-- Quick Actions Card -->
                    <materialDesign:Card Margin="0,0,16,0" 
                                        Effect="{StaticResource Elevation2}"
                                        Background="{StaticResource Primary100Brush}">
                        <materialDesign:Card.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:Card.Triggers>
                        <materialDesign:Card.RenderTransform>
                            <ScaleTransform/>
                        </materialDesign:Card.RenderTransform>
                        <StackPanel Margin="24" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ViewDashboard" 
                                                   Width="40" Height="40" 
                                                   Foreground="{StaticResource Primary700Brush}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Dashboard" 
                                     Style="{StaticResource TitleLarge}" 
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="Overview &amp; Analytics" 
                                     Style="{StaticResource BodyMedium}" 
                                     Foreground="{DynamicResource OnSurface600Brush}"
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Reports Card -->
                    <materialDesign:Card Margin="0,0,16,0" 
                                        Effect="{StaticResource Elevation2}"
                                        Background="{StaticResource Secondary100Brush}">
                        <materialDesign:Card.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:Card.Triggers>
                        <materialDesign:Card.RenderTransform>
                            <ScaleTransform/>
                        </materialDesign:Card.RenderTransform>
                        <StackPanel Margin="24" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartLine" 
                                                   Width="40" Height="40" 
                                                   Foreground="{DynamicResource Secondary700Brush}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Reports" 
                                     Style="{StaticResource TitleLarge}" 
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="Revenue &amp; Analytics" 
                                     Style="{StaticResource BodyMedium}" 
                                     Foreground="{DynamicResource OnSurface600Brush}"
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Management Card -->
                    <materialDesign:Card Effect="{StaticResource Elevation2}"
                                        Background="{DynamicResource Accent100Brush}">
                        <materialDesign:Card.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:Card.Triggers>
                        <materialDesign:Card.RenderTransform>
                            <ScaleTransform/>
                        </materialDesign:Card.RenderTransform>
                        <StackPanel Margin="24" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountMultiple" 
                                                   Width="40" Height="40" 
                                                    Foreground="{DynamicResource Accent100Brush}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Management" 
                                     Style="{StaticResource TitleLarge}" 
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="Staff &amp; Operations" 
                                     Style="{StaticResource BodyMedium}" 
                                     Foreground="{DynamicResource OnSurface600Brush}" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- Dynamic Content Area -->
                <materialDesign:Card Grid.Row="1" 
                                    Effect="{StaticResource Elevation3}"
                                    Background="{StaticResource SurfaceBrush}">
                    <ContentControl x:Name="CurrentContent"
                                    Content="{Binding CurrentContent}"
                                    Margin="24">
                        <ContentControl.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.1"/>
                                <GradientStop Color="Black" Offset="0.9"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </ContentControl.OpacityMask>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                       From="0" To="1" Duration="0:0:0.5"/>
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                          From="40,40,40,40" To="24,24,24,24" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
