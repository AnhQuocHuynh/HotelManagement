<UserControl x:Class="HotelManager.Views.StaffViews.ManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManager.Views.StaffViews"
        xmlns:vm="clr-namespace:HotelManager.ViewModels.StaffViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DesignHeight="800" d:DesignWidth="1200">

    <materialDesign:Card Effect="{StaticResource Elevation3}">
        <Grid Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Margin="0,0,0,0">
                <Grid Margin="32,15,32,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Manager Title and Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Manager Dashboard" 
                                   Style="{StaticResource HeadlineLarge}" 
                                   Foreground="White" Height="45"/>
                        <TextBlock Text="Manage hotel operations and reports" 
                                   Style="{StaticResource BodyMedium}" 
                                   Foreground="{StaticResource OnPrimary200Brush}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- View Options ComboBox -->
                    <materialDesign:Card Grid.Column="1" 
                                        Margin="0,0,24,0" 
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Primary200Brush}">

                    </materialDesign:Card>

                    <!-- Logout Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnProfile" Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Profile" Command="{Binding NavigateProfileCommand}" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Account" Foreground="White"/>
                        </Button>
                        <Button x:Name="btnLogout" Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Logout" Command="{Binding LogoutCommand}" Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="Logout" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- hover trigger -->
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard FillBehavior="HoldEnd">
                                <DoubleAnimation Storyboard.TargetName="StatsContainer"
                                 Storyboard.TargetProperty="MaxHeight"
                                 To="320"
                                 Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard FillBehavior="HoldEnd">
                                <DoubleAnimation Storyboard.TargetName="StatsContainer"
                                 Storyboard.TargetProperty="MaxHeight"
                                 To="0"
                                 Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- hover grid -->
                <Grid Grid.Row="0"
                      x:Name="StatsContainer"
                      MaxHeight="0"
                      Background="Transparent">

                    <!-- Stats Cards -->
                    <UniformGrid Rows="1" 
                                 Columns="3" 
                                 Margin="24,10,24,0">
                        <!-- Quick Actions Card -->
                        <Button x:Name="ReportsCardButton"
                                Command="{Binding NavigateWorkScheduleCommand}"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                Style="{x:Null}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Padding="0"
                                Margin="0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>

                            <materialDesign:Card Margin="0,0,16,0" 
                                        Effect="{StaticResource Elevation2}"
                                        Background="{StaticResource Primary100Brush}">
                                <materialDesign:Card.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.02" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                       To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:Card.Triggers>
                                <materialDesign:Card.RenderTransform>
                                    <ScaleTransform/>
                                </materialDesign:Card.RenderTransform>
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ScheduledMaintenance" 
                                                   Width="40" Height="40" 
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" 
                                     Style="{StaticResource TitleLarge}" 
                                     HorizontalAlignment="Center" 
                                     Margin="0,16,0,0"/>
                                    <TextBlock Text="Overview &amp; Analytics" 
                                     Style="{StaticResource BodyMedium}" 
                                     Foreground="{DynamicResource OnSurface600Brush}"
                                     HorizontalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <!-- Reports Card -->
                        <Button x:Name="WorkScheduleButton"
                                Command="{Binding ShowReportsCommand}"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                Style="{x:Null}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Padding="0"
                                Margin="0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>

                            <materialDesign:Card Margin="0,0,16,0" 
                                                 Effect="{StaticResource Elevation2}"
                                                 Background="{StaticResource Secondary100Brush}">
                                <materialDesign:Card.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.02" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.02" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:Card.Triggers>
                                <materialDesign:Card.RenderTransform>
                                    <ScaleTransform/>
                                </materialDesign:Card.RenderTransform>
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChartLine"                 
                                                             Width="40" Height="40" 
                                                             Foreground="{DynamicResource Primary500Brush}"
                                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Reports" 
                                               Style="{StaticResource TitleLarge}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,16,0,0"/>
                                    <TextBlock Text="Revenue &amp; Analytics" 
                                               Style="{StaticResource BodyMedium}" 
                                               Foreground="{DynamicResource OnSurface600Brush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:Card>

                        </Button>

                        <!-- Management Card -->
                        <Button x:Name="managementCardButton"
                                Command="{Binding ShowEmployeeListCommand}"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                Style="{x:Null}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Padding="0"
                                Margin="0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>

                            <materialDesign:Card Effect="{StaticResource Elevation2}"
                                             Background="{DynamicResource Warning100Brush}">
                                <materialDesign:Card.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1.02" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1.02" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:Card.Triggers>
                                <materialDesign:Card.RenderTransform>
                                    <ScaleTransform/>
                                </materialDesign:Card.RenderTransform>
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountMultiple" 
                                   Width="40" Height="40" 
                                    Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="Management" 
                     Style="{StaticResource TitleLarge}" 
                     HorizontalAlignment="Center" 
                     Margin="0,16,0,0"/>
                                    <TextBlock Text="Staff &amp; Operations" 
                     Style="{StaticResource BodyMedium}" 
                     Foreground="{DynamicResource OnSurface600Brush}" 
                     HorizontalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:Card>

                        </Button>

                    </UniformGrid>

                    <!-- hover trigger -->
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard FillBehavior="HoldEnd">
                                    <DoubleAnimation Storyboard.TargetName="StatsContainer"
                                 Storyboard.TargetProperty="MaxHeight"
                                 To="320"
                                 Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard FillBehavior="HoldEnd">
                                    <DoubleAnimation Storyboard.TargetName="StatsContainer"
                                 Storyboard.TargetProperty="MaxHeight"
                                 To="0"
                                 Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>


                </Grid>

           <!-- Dynamic Content Area -->
                <materialDesign:Card Grid.Row="1" 
                                    Effect="{StaticResource Elevation3}"
                                    Background="{StaticResource SurfaceBrush}">
                    <ContentControl x:Name="CurrentContent"
                                    Content="{Binding CurrentContent}"
                                    Margin="0,0,0,0">

                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                       From="0" To="1" Duration="0:0:0.5"/>
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                          From="40,40,40,40" To="24,24,24,24" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
