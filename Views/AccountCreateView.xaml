<Window x:Class="HotelManager.Views.AccountCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HotelManager.Views"
             xmlns:helpers="clr-namespace:HotelManager.Helpers"
             xmlns:converters="clr-namespace:HotelManager.Converters"
             mc:Ignorable="d" 
             SizeToContent="WidthAndHeight"
             WindowStartupLocation="CenterOwner"
             ResizeMode="NoResize"
             Title="Create Account" d:DesignWidth="500" Height="707">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    

    <Border Background="White" CornerRadius="16" Padding="24">
        <StackPanel Width="400">
            <!-- Header -->
            <TextBlock Text="Create Account" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Employee Info -->
            <Border Background="{StaticResource MaterialDesignDarkSeparatorBackground}" 
                    CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Employee:" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding Employee.FullName}" FontSize="16" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Employee.Email}" FontSize="14" 
                               Foreground="{StaticResource SecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Username -->
            <TextBlock Text="Username:*" Foreground="{StaticResource SecondaryBrush}" />
            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,10"/>
            <TextBlock Text="{Binding UsernameError}" Foreground="Red" FontSize="12" 
                       Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibilityConverter}}" 
                       Margin="0,0,0,10"/>

            <!-- Password -->
            <TextBlock Text="Password:*" Foreground="{StaticResource SecondaryBrush}" />
            <PasswordBox x:Name="PasswordBox" 
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,5,0,10"
                         helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding PasswordError}" Foreground="Red" FontSize="12" 
                       Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibilityConverter}}" 
                       Margin="0,0,0,10"/>

            <!-- Confirm Password -->
            <TextBlock Text="Confirm Password:*" Foreground="{StaticResource SecondaryBrush}" />
            <PasswordBox x:Name="ConfirmPasswordBox" 
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,5,0,10"
                         helpers:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding ConfirmPasswordError}" Foreground="Red" FontSize="12" 
                       Visibility="{Binding ConfirmPasswordError, Converter={StaticResource StringToVisibilityConverter}}" 
                       Margin="0,0,0,10"/>

            <!-- Role -->
            <TextBlock Text="Role:*" Foreground="{StaticResource SecondaryBrush}" />
            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                      ItemsSource="{Binding AvailableRoles}" 
                      SelectedItem="{Binding SelectedRole}"
                      Margin="0,5,0,20"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Create Account" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource MaterialDesignContainedButton}" 
                        Height="40"/>

                <Button Grid.Column="2" Content="Cancel" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Height="40"/>
            </Grid>
        </StackPanel>
    </Border>
</Window> 