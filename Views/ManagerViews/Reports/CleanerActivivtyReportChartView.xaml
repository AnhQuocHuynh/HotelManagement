<UserControl x:Class="HotelManager.Views.ManagerViews.Reports.CleanerActivivtyReportChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HotelManager.Views.ManagerViews.Reports"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             xmlns:vm="clr-namespace:HotelManager.ViewModels.ManagerViewModels.Reports"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Start date -->
            <TextBlock Text="Start date"
                   FontSize="16"
                   FontWeight="DemiBold"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,0,0,0"/>
            <DatePicker x:Name="StartDatePicker"
                    Width="100"
                    Height="25"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="10,0,0,0"
                    SelectedDate="{Binding StartDate, Mode=TwoWay}"/>

            <!-- End date -->
            <TextBlock Text="End date"
                   FontSize="16"
                   FontWeight="DemiBold"
                   Grid.Column="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,0,0,0"/>
            <DatePicker x:Name="EndDatePicker"
                    Width="100"
                    Height="25"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="10,0,0,0"
                    SelectedDate="{Binding EndDate, Mode=TwoWay}"/>

            <Button x:Name="FilterButton" 
                    Content="Apply"
                    Grid.Column="2"
                Command="{Binding ApplyFilterCommand}"
                Foreground="Navy"
                Background="{StaticResource Primary100Brush}"
                Margin="10,0,0,0"/>

            <Button x:Name="exportButton" 
                    Content="Export"
                    Grid.Column="3"
                Command="{Binding ExportChartAndDataCommand}"
                Foreground="Navy"
                Background="{StaticResource Primary100Brush}"
                Margin="10,0,0,0"/>

        </Grid>

        <!-- chart -->
        <lvc:CartesianChart Grid.Row="1"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            ZoomMode="Y"
                            ZoomingSpeed="0.5"
                            TooltipPosition="Left"
                            DrawMarginFrame="{x:Null}"
                            LegendPosition="Top"/>
    </Grid>
</UserControl>
