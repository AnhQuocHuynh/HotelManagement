<UserControl x:Class="HotelManager.Views.ManagerViews.RevenueReportChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HotelManager.Views.ManagerViews"
             
             xmlns:vm="clr-namespace:HotelManager.ViewModels.ManagerViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800"
             Background="White">

    <UserControl.DataContext>
        <vm:RevenueReportChartViewModel/>
    </UserControl.DataContext>

<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Unit"
                   FontSize="16"
                   FontWeight="DemiBold"
                   Grid.Row="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>
        <ComboBox Name="TimeUnit"
                  Width="100"
                  Height="25"
                  Grid.Row="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  ItemsSource="{Binding TimeUnits}"
                  SelectedItem="{Binding SelectedTimeUnit}"/>

        <TextBlock Text="Start date"
                   FontSize="16"
                   FontWeight="DemiBold"
                   Grid.Row="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="110,0,0,0"/>
        <DatePicker x:Name="StartDatePicker"
                    Width="100"
                    Height="25"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="110,0,0,0"
                    SelectedDate="{Binding StartDate, Mode=TwoWay}"/>

        <TextBlock Text="End date"
                   FontSize="16"
                   FontWeight="DemiBold"
                   Grid.Row="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="220,0,0,0"/>
        <DatePicker x:Name="EndDatePicker"
                    Width="100"
                    Height="25"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="220,0,0,0"
                    SelectedDate="{Binding EndDate, Mode=TwoWay}"/>

        <TextBlock Text="Room type"
                   FontSize="16"
                   FontWeight="DemiBold"
                   Grid.Row="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="330,0,0,0"/>
        <ComboBox x:Name="RoomType"
                  Width="100"
                  Height="25"
                  Grid.Row="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="330,0,0,0"
                  ItemsSource="{Binding RoomTypes}"
                  SelectedItem="{Binding SelectedRoomType}"/>

        <lvc:CartesianChart Grid.Row="1"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            Margin="10"/>
    </Grid>
</UserControl>
