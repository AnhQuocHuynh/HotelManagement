<UserControl x:Class="HotelManager.Views.ManagerViews.EmployeesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:vm="clr-namespace:HotelManager.ViewModels.ManagerViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Language="vi-VN">



    <Grid Margin="0"
          Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- filter -->
            <Grid Grid.Row="0" 
                     VerticalAlignment="Center" 
                     HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- name filter -->
                <StackPanel Grid.Column="0"
                            Grid.Row="0" 
                            Orientation="Vertical"
                            Margin="8,0">
                    <TextBlock Text="Name" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource OutlinedTextField}"
                             Text="{Binding FilterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>


                <!-- mail filter -->
                <StackPanel Grid.Column="1"
                            Grid.Row="0"
                    Orientation="Vertical"
                        Margin="8,0">
                    <TextBlock Text="Mail" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource OutlinedTextField}"
                         Text="{Binding FilterMail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- phone filter -->
                <StackPanel Grid.Column="2"
                            Grid.Row="0"
                    Orientation="Vertical"
                        Margin="8,0">
                    <TextBlock Text="Phone" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource OutlinedTextField}"
                         Text="{Binding FilterPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>


                <!-- CCCD filter -->
                <StackPanel Grid.Column="0"
                            Grid.Row="1"
                    Orientation="Vertical"
                        Margin="8,0">
                    <TextBlock Text="CCCD" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource OutlinedTextField}"
                         Text="{Binding FilterCCCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <UniformGrid Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Grid.Row="1"
                             Columns="3"
                             Rows="1">

                    <!-- hire date filter -->
                    <StackPanel Orientation="Vertical"
                        Margin="8,0">
                        <TextBlock Text="Hire date from" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                        <DatePicker SelectedDate="{Binding FilterHireDateFrom, Mode=TwoWay}"
                                Height="50"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                Margin="8,0"
                                >
                        <TextBlock Text="to" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                        <DatePicker SelectedDate="{Binding FilterHireDateTo, Mode=TwoWay}"
                                Height="50"/>
                    </StackPanel>

                    <!-- positon filter -->
                    <StackPanel Orientation="Vertical"
                        Margin="8,0">
                        <TextBlock Text="Positions" 
                           Style="{StaticResource LabelLarge}"
                           Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Positions}"
                              SelectedItem="{Binding SelectedPosition}"
                              Height="50"/>
                    </StackPanel>

                </UniformGrid>

            </Grid>
               

                <UniformGrid Grid.Column="1"
                         Columns="1"
                         Rows="3"
                         Margin="20,0,20,0">

                    <Button Content="Reset" 
                        Height="45"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource OutlinedButton}"
                        Command="{Binding ResetCommand}"

                        BorderBrush="{DynamicResource Secondary500Brush}"
                        ToolTip="reset filter">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusS}"
                                    Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Reset" 
                                           Foreground="{DynamicResource Secondary500Brush}"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>


                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Apply"
                        Height="45"
                        VerticalAlignment="Bottom"
                        Command="{Binding ApplyFilterCommand}"
                        Style="{StaticResource ContainedButton}"
                        Background="{DynamicResource Secondary500Brush}"
                        Foreground="White"
                        FontWeight="SemiBold"/>

                <Button Content="Export"
                        Height="45"
                        VerticalAlignment="Bottom"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ContainedButton}"
                        Background="{DynamicResource OnSurface600Brush}"
                        Foreground="White"
                        FontWeight="SemiBold"/>

            </UniformGrid>

            </Grid>


            <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Employees}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                        Binding="{Binding Id}" />
                <DataGridTextColumn Header="Tên" 
                                        Binding="{Binding FullName}" />
                <DataGridTextColumn Header="Email" 
                                        Binding="{Binding Email}" />
                <DataGridTextColumn Header="SĐT" 
                                        Binding="{Binding PhoneNumber}" />
                <DataGridTextColumn Header="Ngày vào làm" 
                                        Binding="{Binding HireDate, StringFormat=dd/MM/yyyy}" />
                <DataGridTextColumn Header="Chức vụ" 
                                        Binding="{Binding Position}" />
                <DataGridTextColumn Header="CCCD" 
                                        Binding="{Binding CCCD}" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
