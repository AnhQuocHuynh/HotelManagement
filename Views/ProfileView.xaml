<UserControl x:Class="HotelManager.Views.ProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="900" d:DesignWidth="1400"
        Background="{StaticResource SurfaceGradient}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Stats Card Style -->
        <Style x:Key="StatsCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Effect" Value="{StaticResource Elevation2}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource Elevation3}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <materialDesign:Card Effect="{StaticResource Elevation3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Margin="0,-27,0,0">
                <Grid Margin="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile Title and Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="User Profile" 
                                   Style="{StaticResource HeadlineLarge}" 
                                   Foreground="White"/>
                        <TextBlock Text="View and edit your profile information" 
                                   Style="{StaticResource BodyMedium}" 
                                   Foreground="{StaticResource OnPrimary200Brush}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Back Button -->
                    <Button Grid.Column="1"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource ContainedButton}"
                            Background="White"
                            Foreground="{StaticResource PrimaryBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Back"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,102,0,0" Grid.RowSpan="2">
                <StackPanel Margin="32">

                    <!-- Profile Card -->
                    <materialDesign:Card Style="{StaticResource StatsCard}" Margin="0,0,0,24">
                        <StackPanel Margin="24">

                            <!-- Profile Header -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" 
                                        Background="{StaticResource Primary100Brush}" 
                                        CornerRadius="50" 
                                        Width="100" 
                                        Height="100"
                                        Margin="0,0,24,0">
                                    <materialDesign:PackIcon Kind="Account" 
                                                           Width="48" 
                                                           Height="48"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                </Border>

                                <!-- User Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" 
                                             Style="{StaticResource HeadlineMedium}"
                                             FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Username}" 
                                             Style="{StaticResource BodyLarge}"
                                             Foreground="{StaticResource OnSurfaceVariantBrush}"
                                             Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Role}" 
                                             Style="{StaticResource BodyMedium}"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Edit Button -->
                                
                            </Grid>

                            <!-- Profile Form -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1: Basic Info -->
                                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,16">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Full Name *" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Enter full name"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               IsReadOnly="{Binding IsReadOnly}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0">
                                        <TextBlock Text="Username" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Username (read-only)"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding Username}"
                                               IsReadOnly="True"
                                               Background="{StaticResource SurfaceBrush}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Role" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="User role (read-only)"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding Role}"
                                               IsReadOnly="True"
                                               Background="{StaticResource SurfaceBrush}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Row 2: Contact Info -->
                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Email *" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Enter email"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               IsReadOnly="{Binding IsReadOnly}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0">
                                        <TextBlock Text="Phone Number *" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Enter phone number"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               IsReadOnly="{Binding IsReadOnly}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,0,0" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="ID Card *" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Enter ID card number"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding CCCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               IsReadOnly="{Binding IsReadOnly}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Row 3: Employee Specific Info -->
                                <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16" 
                                           Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Position" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Employee position (read-only)"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding Position}"
                                               IsReadOnly="True"
                                               Background="{StaticResource SurfaceBrush}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0">
                                        <TextBlock Text="Hire Date" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Hire date (read-only)"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding HireDate, StringFormat=dd/MM/yyyy}"
                                               IsReadOnly="True"
                                               Background="{StaticResource SurfaceBrush}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Department" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource OutlinedTextField}"
                                               materialDesign:HintAssist.Hint="Department (read-only)"
                                               materialDesign:HintAssist.IsFloating="False"
                                               Text="{Binding Department}"
                                               IsReadOnly="True"
                                               Background="{StaticResource SurfaceBrush}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Row 4: Password Change -->
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,16" 
                                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="New Password" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <PasswordBox Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                                   materialDesign:HintAssist.Hint="Enter new password (optional)"
                                                   materialDesign:HintAssist.IsFloating="False"
                                                   x:Name="NewPasswordBox"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Confirm Password" 
                                                 Style="{StaticResource LabelLarge}"
                                                 Margin="0,0,0,8"/>
                                        <PasswordBox Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                                   materialDesign:HintAssist.Hint="Confirm new password"
                                                   materialDesign:HintAssist.IsFloating="False"
                                                   x:Name="ConfirmPasswordBox"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Right"
                                      Margin="0,24,0,0"
                                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}">
                                <Button Command="{Binding SaveCommand}"
                                      Style="{StaticResource ContainedButton}"
                                      Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="Save Changes"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding CancelCommand}"
                                      Style="{StaticResource OutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="Cancel"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Account Security Section -->
                    <materialDesign:Card Style="{StaticResource StatsCard}" Margin="0,0,0,24">
                        <StackPanel Margin="24">
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Shield" 
                                                           Foreground="{StaticResource PrimaryBrush}" 
                                                           Width="24" Height="24" 
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="Account Security" 
                                             Style="{StaticResource HeadlineSmall}"
                                             Margin="12,0,0,0" 
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Last Login" 
                                             Style="{StaticResource BodyLarge}"
                                             FontWeight="Medium"/>
                                    <TextBlock Text="{Binding LastLoginDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                             Style="{StaticResource BodyMedium}"
                                             Foreground="{StaticResource OnSurfaceVariantBrush}"
                                             Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding ChangePasswordCommand}"
                                        Style="{StaticResource OutlinedButton}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Key" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="Change Password"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl> 