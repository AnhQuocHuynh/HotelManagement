<UserControl x:Class="HotelManager.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HotelManager.Views"
             xmlns:enums="clr-namespace:HotelManager.Models.Enums;assembly=HotelManager.Core"
             xmlns:vm="clr-namespace:HotelManager.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <UserControl.DataContext>
        <vm:PaymentViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <!-- Style cho DatePicker trong DataGrid -->
        <Style x:Key="DataGridDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Style cho ComboBox trong DataGrid -->
        <Style x:Key="DataGridComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ObjectDataProvider cho PaymentMethod -->
        <ObjectDataProvider x:Key="PaymentMethodValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:PaymentMethod"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid Background="{StaticResource AccentBrush}">
        <!-- Header with title and logout button -->
        <Border Background="{StaticResource PrimaryBrush}" Height="50" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Payment Management" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="20,0,0,0"/>
                <Button Content="Logout" 
                        Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Width="80" 
                        Height="30" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,20,0"
                        Background="DarkRed"
                        Foreground="White"/>
            </Grid>
        </Border>

        <!-- Input Controls -->
        <Grid Margin="10,60,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Labels Row 1 -->
                <RowDefinition Height="Auto"/> <!-- Inputs Row 1 -->
                <RowDefinition Height="Auto"/> <!-- Add Button Row -->
                <RowDefinition Height="*"/> <!-- DataGrid -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/> <!-- Thêm cột cho Remaining Amount -->
            </Grid.ColumnDefinitions>

            <!-- Labels Row 1 -->
            <TextBlock Text="Payment Date:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Background="Azure" Padding="5" Margin="0,0,5,5"/>
            <TextBlock Text="Amount:" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Background="Azure" Padding="5" Margin="0,0,5,5"/>
            <TextBlock Text="Payment Method:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Background="Azure" Padding="5" Margin="0,0,5,5"/>
            <TextBlock Text="Invoice:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Background="Azure" Padding="5" Margin="0,0,5,5"/>
            <TextBlock Text="Remaining:" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Background="Azure" Padding="5" Margin="0,0,5,5"/>

            <!-- Inputs Row 1 -->
            <DatePicker x:Name="PaymentDatePicker" Grid.Row="1" Grid.Column="0" Height="30" Margin="0,0,5,5" SelectedDate="{Binding PaymentDate, Mode=TwoWay}"/>
            <TextBox x:Name="AmountTextBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,5,5" Style="{StaticResource DefaultTextBoxStyle}" Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox x:Name="PaymentMethodBox"
                      Grid.Row="1" Grid.Column="2"
                      Height="30" Margin="0,0,5,5"
                      SelectedItem="{Binding PaymentMethod, Mode=TwoWay}"
                      ItemsSource="{Binding Source={StaticResource PaymentMethodValues}}"
                      BorderBrush="{DynamicResource PrimaryBrush}" />
            <ComboBox x:Name="InvoiceBox" Grid.Row="1" Grid.Column="3" Height="30" Margin="0,0,5,5" ItemsSource="{Binding AvailableInvoices}" DisplayMemberPath="Id" SelectedValuePath="Id" SelectedValue="{Binding SelectedInvoiceId, Mode=TwoWay}" BorderBrush="{DynamicResource PrimaryBrush}"/>
            <TextBlock x:Name="RemainingTextBlock" Grid.Row="1" Grid.Column="4" Height="30" VerticalAlignment="Center" Margin="0,0,5,5" Text="{Binding RemainingAmount, StringFormat=c}" />

            <!-- Add Button Row -->
            <Button Content="Add Payment"
                    Command="{Binding AddPaymentCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    Width="150"
                    Height="30"
                    Grid.Row="2"
                    Grid.ColumnSpan="5"
                    HorizontalAlignment="Right"
                    Margin="0,5,5,5"/>

            <!-- DataGrid for Payments -->
            <DataGrid ItemsSource="{Binding Payments}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      SelectionMode="Single"
                      Grid.Row="3"
                      Grid.ColumnSpan="5"
                      Margin="0,5,0,0"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      SelectedItem="{Binding SelectedPayment}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                        Binding="{Binding Id}" 
                                        Width="*"
                                        IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Payment Date" 
                                           Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PaymentDate, StringFormat=d}" 
                                           VerticalAlignment="Center" 
                                           Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding PaymentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Style="{StaticResource DataGridDatePickerStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Amount" 
                                        Binding="{Binding Amount, StringFormat=c, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="*"
                                        IsReadOnly="False"/>
                    <DataGridTemplateColumn Header="Method" 
                                           Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PaymentMethod}" 
                                           VerticalAlignment="Center" 
                                           Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          ItemsSource="{Binding Source={StaticResource PaymentMethodValues}}"
                                          Style="{StaticResource DataGridComboBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Invoice ID" 
                                        Binding="{Binding InvoiceId}" 
                                        Width="*"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Remaining Amount" 
                                        Binding="{Binding RemainingAmount, StringFormat=c}" 
                                        Width="*"
                                        IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save" Command="{Binding DataContext.SavePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Width="40" Margin="2" Style="{StaticResource DefaultButtonStyle}"/>
                                    <Button Content="Delete" Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Width="40" Margin="2" Style="{StaticResource DefaultButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>