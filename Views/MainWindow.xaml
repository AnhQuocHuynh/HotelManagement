<Window x:Class="HotelManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelManager.ViewModels"
        Title="Hotel Manager" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <StackPanel>
        <UserControl x:Name="MainUserControl" Content="{Binding CurrentView}" />
    </StackPanel>
</Window>