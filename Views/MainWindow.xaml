<Window x:Class="HotelManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelManager.ViewModels"
        xmlns:views="clr-namespace:HotelManager.Views"
        xmlns:staff="clr-namespace:HotelManager.Views.StaffViews"
        xmlns:utilities="clr-namespace:HotelManager.Utilities"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:HotelManager.Converters"
        Title="Hotel Management System" 
        Height="900" 
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{StaticResource PrimaryFont}"
        Style="{DynamicResource MaterialDesignWindow}">
    


    <Window.Resources>
        <!-- Glassmorphism effect for backdrop -->
        <BlurEffect x:Key="BlurEffect" Radius="5"/>
        
        <!-- Window chrome style -->
        <Style x:Key="ModernWindowStyle" TargetType="Window">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary200}"/>
            <Setter Property="Effect" Value="{StaticResource Elevation3}"/>
        </Style>

        <converters:LoginViewVisibilityConverter x:Key="LoginViewVisConverter"/>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="MainDialogHost" 
                              CloseOnClickAway="True">
        <materialDesign:DrawerHost Name="MainDrawerHost">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- Modern Title Bar -->
                <Border x:Name="TitleBar" Grid.Row="0" 
                        Background="{StaticResource PrimaryGradient}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                        </Style>
                    </Border.Style>
                    <Grid Margin="0,-22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Logo & Title -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    Margin="24">
                            <materialDesign:PackIcon Kind="Hotel" 
                                                     Foreground="White" 
                                                     Width="32" 
                                                     Height="32" 
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Hotel Management" 
                                       Style="{StaticResource TitleLarge}"
                                       Foreground="White" 
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Title/Breadcrumb Area -->
                        <StackPanel Grid.Column="1" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CurrentViewTitle}" 
                                       Style="{StaticResource HeadlineMedium}"
                                       Foreground="White" 
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- User Info & Actions -->
                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    Margin="24">
                            
                            <!-- Notifications -->
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="Notifications"
                                    Background="Transparent"
                                    Margin="0,0,8,0">
                                
                            </Button>

                            <!-- Settings -->
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="Settings"
                                    Background="Transparent"
                                    Margin="0,0,16,0">
                                
                            </Button>

                            <!-- User Profile -->
                            <Border Background="White" 
                                    CornerRadius="20" 
                                    Width="40" 
                                    Height="40" 
                                    Effect="{StaticResource Elevation1}">
                                <materialDesign:PackIcon Kind="Account" 
                                                         Foreground="{StaticResource PrimaryBrush}" 
                                                         Width="24" 
                                                         Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area with Material Design Card -->
                <materialDesign:Card Grid.Row="1" 
                                     Margin="16"
                                     Effect="{StaticResource Elevation2}">
                    <Border CornerRadius="{StaticResource RadiusM}" 
                            Background="{StaticResource BackgroundBrush}">
                        <ContentControl Content="{Binding CurrentView}" 
                                        ClipToBounds="True">
                            <ContentControl.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </ContentControl.RenderTransform>
                            <ContentControl.Triggers>
                                <!-- Fade in animation when content changes -->
                                <EventTrigger RoutedEvent="ContentControl.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                             From="0" To="1" 
                                                             Duration="{StaticResource AnimationMedium}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" 
                                                             From="0.95" To="1" 
                                                             Duration="{StaticResource AnimationMedium}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" 
                                                             From="0.95" To="1" 
                                                             Duration="{StaticResource AnimationMedium}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ContentControl.Triggers>
                        </ContentControl>
                    </Border>
                </materialDesign:Card>

                <!-- Status Bar -->
                <Border Grid.Row="2" 
                        Background="{StaticResource SurfaceBrush}" 
                        Height="32" 
                        BorderBrush="{StaticResource OnSurfaceVariantBrush}" 
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Messages -->
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding StatusMessage}" 
                                   Style="{StaticResource BodyMedium}"
                                   VerticalAlignment="Center" 
                                   Margin="16"/>

                        <!-- Current User Info -->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    Margin="8">
                            
                            <TextBlock Text="{Binding CurrentUser}" 
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" 
                                       Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- System Time -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy HH:mm'}" 
                                   Style="{StaticResource BodyMedium}"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" 
                                   Margin="32"/>
                    </Grid>
                </Border>

                <!-- Snackbar for notifications -->
                <materialDesign:Snackbar x:Name="MainSnackbar" 
                                         Grid.Row="1"
                                         MessageQueue="{materialDesign:MessageQueue}"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Center"
                                         Margin="32"/>
            </Grid>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>