<Window x:Class="HotelManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelManager.ViewModels"
        Title="Hotel Manager" Height="300" Width="400">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <StackPanel Margin="20">
        <TextBlock Text="{Binding WelcomeMessage}" FontSize="20" Margin="0 0 0 10"/>
        <Button Content="Click Me!" Command="{Binding ShowCleanerCommand}" Width="100" Height="30"/>
    </StackPanel>
</Window>