<UserControl x:Class="HotelManager.Views.Common.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:HotelManager.ViewModels.Common"
             xmlns:helpers="clr-namespace:HotelManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="Transparent">

    <UserControl.DataContext>
        <vm:LoginViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>

        <Border Width="600" Height="350"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="10"
                BorderBrush="Transparent"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Who are you -->
                <TextBlock Text="Who are you?"
                           Foreground="Black"
                           FontSize="20"
                           Grid.Row="0"
                           HorizontalAlignment="Center" 
                           Margin="0,10,0,0"></TextBlock>

                <!-- manager button -->
                <Button x:Name="isManager_btn"
                        Content="Manager"
                        Style="{StaticResource DefaultButtonStyle}"
                        Height="30"
                        Width="100"
                        Margin="0,30,250,0"
                        Command="{Binding IsManagerCommand}"></Button>

                <!-- receptionist button -->
                <Button x:Name="isReceptionist_btn"
                        Content="Receptionist"
                        Style="{StaticResource DefaultButtonStyle}"
                        Height="30"
                        Width="100"
                        Margin="0,30,0,0"
                        Command="{Binding IsReceptionistCommand}"></Button>

                <!-- attendent button -->
                <Button x:Name="isAttendent_btn"
                        Content="Attendent"
                        Style="{StaticResource DefaultButtonStyle}"
                        Height="30"
                        Width="100"
                        Margin="0,30,-250,0"
                        Command="{Binding IsAttendentCommand}"></Button>

                <!-- input border -->
                <Border Grid.Row="1"
                        Background="{StaticResource SecondaryBrush}"
                        CornerRadius="0,0,10,10">
                    <Grid>

                        <!-- user name -->
                        <TextBlock Text="User Name:"
                                   FontSize="20"
                                   Foreground="#EEEEEE"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="100,20,0,0"></TextBlock>
                        <TextBox x:Name="UserName_tb"
                                 Style="{StaticResource DefaultTextBoxStyle}"
                                 FontWeight="Bold"
                                 Height="30"
                                 Width="400"
                                 Margin="0,0,0,110"
                                 Text="{Binding UserName}"></TextBox>

                        <!-- password -->
                        <TextBlock Text="Password:"
                                   FontSize="20"
                                   Foreground="#EEEEEE"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="100,100,0,0"></TextBlock>

                        <PasswordBox x:Name="Password_PasswordBox"
                                     helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     Width="400"
                                     Margin="0,50,0,0"
                                     Padding="8,6"
                                     Background="White"
                                     BorderBrush="Gray"
                                     BorderThickness="1">
                            <PasswordBox.Template>
                                <ControlTemplate TargetType="PasswordBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </Border>
                                </ControlTemplate>
                            </PasswordBox.Template>
                        </PasswordBox>
                        <TextBox x:Name="Password_tb"
                                 Text="{Binding Password}"
                                 Visibility="{Binding PasswordVisibility, Converter={StaticResource BoolToVisConverter}}"
                                 Style="{StaticResource DefaultTextBoxStyle}"
                                 FontWeight="Bold"
                                 Height="30"
                                 Width="400"
                                 Margin="0,50,0,0"></TextBox>
                        <!-- show password -->
                        <CheckBox x:Name="showPassword_CheckBos"
                                  IsChecked="{Binding PasswordVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,70,90">
                        </CheckBox>
                        <!-- login button -->
                        <Button x:Name="Login_btn"
                                Style="{StaticResource DefaultButtonStyle}"
                                Content="Login"
                                Height="30"
                                Width="100"
                                Margin="0,150,0,0"
                                Command="{Binding LoginCommand}"></Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
