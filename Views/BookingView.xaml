<UserControl x:Class="HotelManager.Views.BookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelManager.ViewModels"
        xmlns:enums="clr-namespace:HotelManager.Models.Enums;assembly=HotelManager.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="800" Width="1400">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="RoomTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:RoomType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="BookingStatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BookingStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Status Indicator Style -->
        <Style x:Key="BookingStatusStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusS}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource Primary100Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                    <Setter Property="Background" Value="{StaticResource Success100Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CheckedIn">
                    <Setter Property="Background" Value="{StaticResource Primary100Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CheckedOut">
                    <Setter Property="Background" Value="{StaticResource Secondary100Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="{StaticResource Error100Brush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:BookingViewModel />
    </UserControl.DataContext>

    <materialDesign:Card Effect="{StaticResource Elevation3}">
        <Grid Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Margin="0,-60,0,693" Grid.RowSpan="2">
                <Grid Margin="32">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Booking Management" 
                                   Style="{StaticResource HeadlineLarge}" 
                                   Foreground="White"/>
                        <TextBlock Text="Manage hotel reservations and check-ins" 
                                   Style="{StaticResource BodyMedium}" 
                                   Foreground="{StaticResource OnPrimary200Brush}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search and Filter Section -->
                <materialDesign:Card Grid.Row="0" 
                                    Margin="0,10,0,0"
                                    Effect="{StaticResource Elevation2}" Height="147" VerticalAlignment="Top">
                    <StackPanel Margin="32">
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOutline" 
                                                       Width="24" Height="24" 
                                                       Foreground="{StaticResource Primary500Brush}"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Search and Filter Bookings" 
                                         Style="{StaticResource TitleLarge}" 
                                         Margin="12,0,0,0" 
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Rows="1" Columns="4">
                            <!-- Search Text -->
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                   Style="{StaticResource OutlinedTextField}"
                                   materialDesign:HintAssist.Hint="Search customer name..."
                                   Margin="0,0,16,0">
                                <TextBox.Resources>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Magnify"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Room Type Filter -->
                            <ComboBox ItemsSource="{Binding Source={StaticResource RoomTypeEnum}}" 
                                    SelectedItem="{Binding SelectedRoomType}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}"
                                    materialDesign:HintAssist.Hint="Room Type"
                                    Margin="0,0,16,0"/>

                            <!-- Status Filter -->
                            <ComboBox ItemsSource="{Binding Source={StaticResource BookingStatusEnum}}" 
                                    SelectedItem="{Binding SelectedStatus}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}"
                                    materialDesign:HintAssist.Hint="Booking Status"
                                    Margin="0,0,16,0"/>

                            <!-- Filter Button -->
                            <Button Command="{Binding FilterCommand}"
                                  Style="{StaticResource ContainedButton}"
                                  Background="{StaticResource Secondary500Brush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18"/>
                                    <TextBlock Text="Apply Filter" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Bookings List Section -->
                <materialDesign:Card Grid.Row="1" 
                                    Margin="0,0,0,16"
                                    Effect="{StaticResource Elevation2}">
                    <StackPanel Margin="32">
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarOutline" 
                                                       Width="24" Height="24" 
                                                       Foreground="{StaticResource Primary500Brush}"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Current Bookings" 
                                         Style="{StaticResource TitleLarge}" 
                                         Margin="12,0,0,0" 
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Bookings}" 
                                SelectedItem="{Binding SelectedBooking}" 
                                AutoGenerateColumns="False" 
                                Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <!-- Customer Name -->
                                <DataGridTemplateColumn Header="Customer" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AccountCircle" 
                                                                       Width="16" Height="16" 
                                                                       Foreground="{StaticResource Primary500Brush}"/>
                                                <TextBlock Text="{Binding Customer.FullName}" 
                                                         Style="{StaticResource BodyMedium}" 
                                                         Margin="8,0,0,0" 
                                                         FontWeight="Medium"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Room Information -->
                                <DataGridTemplateColumn Header="Room" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Door" Width="14" Height="14" 
                                                                           Foreground="{StaticResource Secondary500Brush}"/>
                                                    <TextBlock Text="{Binding Room.RoomNumber}" 
                                                             Style="{StaticResource BodyMedium}" 
                                                             FontWeight="Bold" 
                                                             Margin="4,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Room.RoomType}" 
                                                         Style="{StaticResource BodySmall}" 
                                                         Foreground="{StaticResource OnSurface600Brush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Check-in Date -->
                                <DataGridTemplateColumn Header="Check-in" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" 
                                                         Style="{StaticResource BodyMedium}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Check-out Date -->
                                <DataGridTemplateColumn Header="Check-out" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" 
                                                         Style="{StaticResource BodyMedium}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status -->
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BookingStatusStyle}">
                                                <TextBlock Text="{Binding Status}" 
                                                         Style="{StaticResource LabelMedium}" 
                                                         FontWeight="Medium"
                                                         HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Actions" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding}"
                                                      Style="{StaticResource IconButton}"
                                                      ToolTip="Check In"
                                                      Margin="2">
                                                    <materialDesign:PackIcon Kind="Login" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding}"
                                                      Style="{StaticResource IconButton}"
                                                      ToolTip="Check Out"
                                                      Margin="2">
                                                    <materialDesign:PackIcon Kind="Logout" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.EditBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding}"
                                                      Style="{StaticResource IconButton}"
                                                      ToolTip="Edit"
                                                      Margin="2">
                                                    <materialDesign:PackIcon Kind="Edit" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding}"
                                                      Style="{StaticResource IconButton}"
                                                      ToolTip="Delete"
                                                      Margin="2">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Booking Form Section -->
                <materialDesign:Card Grid.Row="2" Effect="{StaticResource Elevation2}">
                    <Expander Header="Booking Information" 
                            IsExpanded="True"
                            Style="{StaticResource MaterialDesignExpander}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormTextbox" 
                                                           Width="24" Height="24" 
                                                           Foreground="{StaticResource Accent500Brush}"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" 
                                             Style="{StaticResource TitleLarge}" 
                                             Margin="12,0,0,0" 
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>

                        <Grid Margin="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- First Row -->
                            <TextBox Grid.Row="0" Grid.Column="0"
                                   Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                   Style="{StaticResource OutlinedTextField}"
                                   materialDesign:HintAssist.Hint="Customer Name"
                                   Margin="0,0,16,16"/>

                            <ComboBox Grid.Row="0" Grid.Column="1"
                                    ItemsSource="{Binding Source={StaticResource RoomTypeEnum}}" 
                                    SelectedItem="{Binding SelectedRoomType}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}"
                                    materialDesign:HintAssist.Hint="Room Type"
                                    Margin="0,0,16,16"/>

                            <TextBox Grid.Row="0" Grid.Column="2"
                                   Text="{Binding SelectedRoomNumber, UpdateSourceTrigger=PropertyChanged}" 
                                   Style="{StaticResource OutlinedTextField}"
                                   materialDesign:HintAssist.Hint="Room Number"
                                   Margin="0,0,0,16"/>

                            <!-- Second Row -->
                            <DatePicker Grid.Row="1" Grid.Column="0"
                                      SelectedDate="{Binding CheckInDate}"
                                      Style="{StaticResource MaterialDesignFilledDatePicker}"
                                      materialDesign:HintAssist.Hint="Check-in Date"
                                      Margin="0,0,16,16"/>

                            <DatePicker Grid.Row="1" Grid.Column="1"
                                      SelectedDate="{Binding CheckOutDate}"
                                      Style="{StaticResource MaterialDesignFilledDatePicker}"
                                      materialDesign:HintAssist.Hint="Check-out Date"
                                      Margin="0,0,16,16"/>

                            <ComboBox Grid.Row="1" Grid.Column="2"
                                    ItemsSource="{Binding Source={StaticResource BookingStatusEnum}}" 
                                    SelectedItem="{Binding SelectedStatus}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}"
                                    materialDesign:HintAssist.Hint="Booking Status"
                                    Margin="0,0,0,16"/>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" 
                                      Orientation="Horizontal" 
                                      HorizontalAlignment="Right"
                                      Margin="0,24,0,16">
                                <Button Command="{Binding AddBookingCommand}"
                                      Style="{StaticResource ContainedButton}"
                                      Background="{StaticResource Primary500Brush}"
                                      Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                        <TextBlock Text="Add Booking" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding EditBookingCommand}"
                                      Style="{StaticResource OutlinedButton}"
                                      BorderBrush="{StaticResource Secondary500Brush}"
                                      Foreground="{StaticResource Secondary500Brush}"
                                      Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Edit" Width="18" Height="18"/>
                                        <TextBlock Text="Edit" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DeleteBookingCommand}"
                                      Style="{StaticResource OutlinedButton}"
                                      BorderBrush="{StaticResource ErrorBrush}"
                                      Foreground="{StaticResource ErrorBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                        <TextBlock Text="Delete" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl> 