<UserControl x:Class="HotelManager.Views.BookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelManager.ViewModels"
        xmlns:enums="clr-namespace:HotelManager.Models.Enums;assembly=HotelManager.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Height="600" Width="1000">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="RoomTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:RoomType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="BookingStatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BookingStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:BookingViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="200" Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Width="120" Margin="0,0,10,0" ItemsSource="{Binding Source={StaticResource RoomTypeEnum}}" SelectedItem="{Binding SelectedRoomType}"/>
            <ComboBox Width="120" Margin="0,0,10,0" ItemsSource="{Binding Source={StaticResource BookingStatusEnum}}" SelectedItem="{Binding SelectedStatus}"/>
            <Button Content="Lọc" Command="{Binding FilterCommand}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}" AutoGenerateColumns="False" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên khách" Binding="{Binding Customer.FullName}"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding Room.RoomType}"/>
                <DataGridTextColumn Header="Số phòng" Binding="{Binding Room.RoomNumber}"/>
                <DataGridTextColumn Header="Ngày nhận" Binding="{Binding CheckInDate}"/>
                <DataGridTextColumn Header="Ngày trả" Binding="{Binding CheckOutDate}"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Header="Thông tin đặt phòng" Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <Label Content="Tên khách hàng" />
                <TextBox Margin="0,0,0,5" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Loại phòng" />
                <ComboBox Margin="0,0,0,5" ItemsSource="{Binding Source={StaticResource RoomTypeEnum}}" SelectedItem="{Binding SelectedRoomType}"/>
                <Label Content="Số phòng" />
                <TextBox Margin="0,0,0,5" Text="{Binding SelectedRoomNumber, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Ngày nhận" />
                <DatePicker Margin="0,0,0,5" SelectedDate="{Binding CheckInDate}"/>
                <Label Content="Ngày trả" />
                <DatePicker Margin="0,0,0,5" SelectedDate="{Binding CheckOutDate}"/>
                <Label Content="Trạng thái" />
                <ComboBox Margin="0,0,0,5" ItemsSource="{Binding Source={StaticResource BookingStatusEnum}}" SelectedItem="{Binding SelectedStatus}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Thêm" Command="{Binding AddBookingCommand}" Margin="0,0,10,0"/>
                    <Button Content="Sửa" Command="{Binding EditBookingCommand}" Margin="0,0,10,0"/>
                    <Button Content="Xóa" Command="{Binding DeleteBookingCommand}" Margin="0,0,10,0"/>
                    <Button Content="Check-in" Command="{Binding CheckInCommand}" Margin="0,0,10,0"/>
                    <Button Content="Check-out" Command="{Binding CheckOutCommand}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl> 