<UserControl x:Class="HotelManager.Views.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HotelManager.Views"
        xmlns:vm="clr-namespace:HotelManager.ViewModels.Admin"
        mc:Ignorable="d"
        d:DesignHeight="900" d:DesignWidth="1400">



    <UserControl.Resources>
        <!-- Stats Card Style -->
        <Style x:Key="StatsCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Effect" Value="{StaticResource Elevation2}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource Elevation3}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceGradient}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32">

                <!-- Header Section -->
                <materialDesign:Card Effect="{StaticResource Elevation2}" 
                                     Margin="0,0,0,24">
                    <Border Background="{StaticResource PrimaryGradient}" 
                            CornerRadius="{StaticResource RadiusM}" 
                            Padding="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Welcome Section -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="White" 
                                        CornerRadius="30" 
                                        Width="60" 
                                        Height="60" 
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="ShieldAccount" 
                                                             Foreground="{StaticResource PrimaryBrush}" 
                                                             Width="32" 
                                                             Height="32"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Greeting}" 
                                               Style="{StaticResource BodyLarge}"
                                               Foreground="White" 
                                               Opacity="0.9"/>
                                    <TextBlock Text="Admin Dashboard" 
                                               Style="{StaticResource HeadlineMedium}"
                                               Foreground="White" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick Stats -->
                            <StackPanel Grid.Column="1" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Center">
                                <Button Content="Reports"
                                        Style="{StaticResource OutlinedButton}"
                                        Command="{Binding ReportsCommand}"
                           Foreground="White" 
                                        BorderBrush="White"
                                        Margin="0,0,12,0"
                                        ToolTip="View detailed reports" Click="Button_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusS}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="Logout" 
                                        Command="{Binding LogoutCommand}"
                                        Style="{StaticResource ContainedButton}"
                                        Background="White"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="193,6,317,4">
                                <!-- Room Management Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                                    <!-- Nút AccountGroup -->
                                    <Button Style="{StaticResource ContainedButton}"
                                            Height="40" Width="168"
                                            Background="{StaticResource PrimaryBrush}"
                                            Foreground="White"
                                            Margin="0,0,8,0"
                                            Command="{Binding AccountGroupCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountGroup" Height="14" Width="35" Margin="0,0,8,0"/>
                                            <TextBlock Text="Account" VerticalAlignment="Center" Height="26" Width="98" TextAlignment="Center" FontSize="18"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Nút Room Management -->
                                    <Button Style="{StaticResource ContainedButton}"
                                            Height="40" Width="180"
                                            Background="{StaticResource PrimaryBrush}"
                                            Foreground="White"
                                            Command="{Binding NavigateRoomManagementCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Hotel" Height="17" Width="24" Margin="0,0,8,0"/>
                                            <TextBlock Text="Room" VerticalAlignment="Center" Height="27" Width="88" TextAlignment="Center" FontSize="18"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Nút Profile Management -->
                                    <Button Style="{StaticResource ContainedButton}"
                                            Height="40" Width="180"
                                            Background="{StaticResource PrimaryBrush}"
                                            Foreground="White"
                                            Command="{Binding NavigateProfileCommand}"
                                            Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Account" Height="17" Width="24" Margin="0,0,8,0"/>
                                            <TextBlock Text="Profile" VerticalAlignment="Center" Height="27" Width="88" TextAlignment="Center" FontSize="18"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <!-- Employee Form Section -->
                <materialDesign:Card Style="{StaticResource StatsCard}" 
                                     Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" 
                                                         Foreground="{StaticResource PrimaryBrush}" 
                                                         Width="24" 
                                                         Height="24" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Add New Employee" 
                                           Style="{StaticResource SectionHeader}"
                                           Margin="12,0,0,0" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Style="{StaticResource TextButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RefreshCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" 
                                                                 Width="16" 
                                                                 Height="16" 
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" 
                                                   Margin="4,0,0,0" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <!-- Form Grid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Personal Info -->
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,16">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Full Name *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource OutlinedTextField}"
                                             materialDesign:HintAssist.Hint="Enter full name"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Text="{Binding EmployeeFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0">
                                    <TextBlock Text="ID Card *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource OutlinedTextField}"
                                             materialDesign:HintAssist.Hint="Enter ID number"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Text="{Binding EmployeeCCCD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Email *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource OutlinedTextField}"
                                             materialDesign:HintAssist.Hint="Enter email"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Text="{Binding EmployeeEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Row 2: Contact & Work Info -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Phone Number *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource OutlinedTextField}"
                                             materialDesign:HintAssist.Hint="Enter phone number"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Text="{Binding EmployeePhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0">
                                    <TextBlock Text="Position *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Select position"
                                              materialDesign:HintAssist.IsFloating="False"
                                              ItemsSource="{Binding EmployeePositions}" 
                                              SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Hire Date *" 
                                               Style="{StaticResource LabelLarge}"
                                               Margin="0,0,0,8"/>
                                    <DatePicker Style="{StaticResource MaterialDesignDatePicker}"
                                                materialDesign:HintAssist.Hint="Pick date"
                                                materialDesign:HintAssist.IsFloating="False"
                                                SelectedDate="{Binding EmployeeHireDate, Mode=TwoWay}" Height="50"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Style="{StaticResource OutlinedButton}"
                                        Margin="0,0,12,0"
                                        Command="{Binding ClearFormCommand}"/>

                                <Button Command="{Binding AddNewEmployeeCommand}"
                                        Style="{StaticResource ContainedButton}"
                                        Margin="0,0,12,0">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountPlus" 
                                                                     Width="18" 
                                                                     Height="18" 
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Add Employee" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                                <Button Command="{Binding CreateAccountCommand}"
                                        Style="{StaticResource ContainedButton}"
                                        Background="{StaticResource SecondaryBrush}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountKey" 
                                                                     Width="18" 
                                                                     Height="18" 
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Create Account" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Employee List Section -->
                <materialDesign:Card Style="{StaticResource StatsCard}">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" 
                                                         Foreground="{StaticResource PrimaryBrush}" 
                                                         Width="24" 
                                                         Height="24" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Employee List" 
                                           Style="{StaticResource SectionHeader}"
                                           Margin="12,0,0,0" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Search Box -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Style="{StaticResource OutlinedTextField}"
                                         materialDesign:HintAssist.Hint="Search employees..."
                                         materialDesign:HintAssist.IsFloating="False"
                                         Width="250"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding SearchCommand}"
                                        ToolTip="Search"
                                        Margin="8,0,0,0">
                                    <materialDesign:PackIcon Kind="Magnify" 
                                                             Width="20" 
                                                             Height="20"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Data Grid -->
                        <Border Background="{StaticResource BackgroundBrush}" 
                                CornerRadius="{StaticResource RadiusS}" 
                                BorderBrush="{StaticResource OnSurfaceVariantBrush}" 
                                BorderThickness="1">
                            <DataGrid ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"               
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      MinHeight="300">
                                <DataGrid.Columns>
                                    <!-- Avatar Column -->
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Primary100Brush}" 
                                                        CornerRadius="20" 
                                                        Width="40" 
                                                        Height="40">
                                                    <TextBlock Text="{Binding FullName, StringFormat={}{0:1}}" 
                                                               Style="{StaticResource LabelLarge}"
                                                               Foreground="{StaticResource PrimaryBrush}" 
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Full Name" 
                                                        Binding="{Binding FullName}" 
                                                        Width="2*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="ID Card" 
                                                        Binding="{Binding CCCD}" 
                                                        Width="*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Email" 
                                                        Binding="{Binding Email}" 
                                                        Width="2*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Phone Number" 
                                                        Binding="{Binding PhoneNumber}" 
                                                        Width="*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Position" 
                                                        Binding="{Binding Position}" 
                                                        Width="*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Hire Date" 
                                                        Binding="{Binding HireDate, StringFormat=dd/MM/yyyy}" 
                                                        Width="*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <DataGridTextColumn Header="Account" 
                                                        Binding="{Binding UserAccount.Username}" 
                                                        Width="*"
                                                        ElementStyle="{StaticResource BodyMedium}"/>

                                    <!-- Actions Column -->
                                    <DataGridTemplateColumn Header="Actions" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center">
                                                    <Button ToolTip="Edit" 
                                                            Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource IconButton}"
                                                            Width="32" 
                                                            Height="32"
                                                            Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="Pencil" 
                                                                                 Width="16" 
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource PrimaryBrush}"/>
                                                    </Button>

                                                    <Button ToolTip="Delete" 
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource IconButton}"
                                                            Width="32" 
                                                            Height="32">
                                                        <materialDesign:PackIcon Kind="Delete" 
                                                                                 Width="16" 
                                                                                 Height="16"
                                                                                 Foreground="{StaticResource ErrorBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Snackbar cho thông báo -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue, Mode=OneWay}" 
                                 VerticalAlignment="Bottom" 
                                 HorizontalAlignment="Center"
                                 Margin="32"/>
    </Grid>
</UserControl>
